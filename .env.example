# Google Analytics Measurement ID
# Get this from your Google Analytics 4 property
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads conversion tag ID (gtag)
# Format: AW-XXXXXXXXX
VITE_GOOGLE_ADS_TAG_ID=AW-XXXXXXXXX

# Optional service-area buffer for zone lookups on the appointment form, in miles.
VITE_ZONE_SEARCH_BUFFER_MILES=10

# In lower envs (dev/staging): set to 'true' to show "Become a Member" / create-client. In production, create-client is always enabled.
# VITE_SHOW_CREATE_CLIENT=true

# PIMS read-only mode: omit or leave unset so client/patient detail and Settings → Employees cannot edit/save.
# VITE_ENABLE_PIMS_ENTITY_EDIT=true

# Care Outreach (Tools): optional click-to-call template for Quo / browser dialer. Use {e164} (e.g. %2B1…) or {digits}.
# If unset, phone links use tel:+… which Quo can handle when set as the default calling app.
# VITE_QUO_CALL_URL_TEMPLATE=
# VITE_QUO_SMS_URL_TEMPLATE=

# API base URL. In local dev, Vite proxies /public and /appointments to localhost:3000 (see vite.config.ts).
# VITE_API_BASE_URL=http://localhost:3000

# Appointment request form: set to 'false' to disable draft save / abandon (default: enabled).
# VITE_APPOINTMENT_FORM_DRAFTS_ENABLED=false

# Minutes of inactivity before idle abandon email (default: 15). Set to 0 to disable.
# VITE_APPOINTMENT_FORM_ABANDON_IDLE_MINUTES=15
